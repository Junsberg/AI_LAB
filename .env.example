# Copy to .env — never commit .env
# Helius free tier: https://dev.helius.xyz
HELIUS_API_KEY=
# Supabase project (Settings > Database > Connection string, session mode)
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# Trading mode: paper | live
MODE=paper
# Live only. Base58 secret key of a SMALL hot wallet. Keep other funds elsewhere.
SOLANA_PRIVATE_KEY=
# Optional: rugcheck.xyz / gmgn keys (free tiers)
RUGCHECK_API_KEY=
GMGN_API_KEY=
